<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>SchoolInventoryScanner</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationId>gr.nyxsystems.schoolinventoryscanner</ApplicationId>
    <ApplicationTitle>School Inventory Scanner</ApplicationTitle>
    <ApplicationDisplayVersion>0.4.1</ApplicationDisplayVersion>
    <ApplicationVersion>41</ApplicationVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>

    <!--
      Warning hygiene for the current native Android implementation.

      CS0618:
      Existing native UI helpers still use Android's deprecated SetBackgroundDrawable API.
      It works on the supported Android versions and will be replaced later in a focused UI helper refactor.

      CA1422:
      Current status/navigation bar and back-button calls are guarded by the Android runtime target,
      but .NET still reports Android API obsoletion/analyzer warnings.

      CS8602:
      One nullable-flow warning remains in the current MainActivity path. Runtime testing on phone/tablet passed.
      We keep this suppression temporary and track it in docs/ANDROID_WARNING_CLEANUP.md.
    -->
    <NoWarn>$(NoWarn);CS0618;CA1422;CS8602</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.GooglePlayServices.Code.Scanner" Version="116.1.0.15" />
  </ItemGroup>

</Project>
